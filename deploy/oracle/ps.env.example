# Copied to /home/ubuntu/asgc/ps.env by setup.sh (which also generates the authkey).
# Every worker needs the same ASGC_AUTHKEY.
ASGC_AUTHKEY=change-me
# Arguments for scripts/ps_server.py. Restart the service after editing:
#   sudo systemctl restart asgc-ps
ASGC_SERVER_ARGS="--task fmnist --port 29500 --compression topk --rho 0.1 --eval-interval-s 30 --max-wall-time-s 1800"
